{
  "name": "pip-companion-source",
  "version": "0.7.2-alpha.3",
  "private": true,
  "description": "Source-run TypeScript AI companion for macOS and experimental native Windows",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc && node scripts/build-ui.cjs",
    "start": "yarn build && node scripts/launch.cjs",
    "test": "yarn build && node scripts/test.cjs",
    "hook:config": "node dist/src/hook.js config",
    "demo": "node dist/src/hook.js demo",
    "smoke": "yarn build && node scripts/launch.cjs --smoke",
    "connect:prepare": "node dist/src/connect.js prepare",
    "connect:apply": "node dist/src/connect.js apply",
    "connect:restore": "node dist/src/connect.js restore",
    "session-links:build": "node scripts/session-links.cjs build",
    "session-links:install": "node scripts/session-links.cjs install"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/proper-lockfile": "4.1.4",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "packageManager": "yarn@1.22.22"
}
